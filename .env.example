# Application
APP_NAME=Multi-Tenant Data Chat Platform
APP_ENV=development
DEBUG=false
API_PREFIX=/api

# Platform database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=data_chat
POSTGRES_USER=data_chat
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+asyncpg://data_chat:change_me@postgres:5432/data_chat

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO object storage
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me
MINIO_BUCKET=documents
MINIO_SECURE=false

# Authentication
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Connection credential encryption
FERNET_KEY=replace_with_a_valid_fernet_key

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# LLM
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=

# SQL safety
SQL_DEFAULT_ROW_LIMIT=100
SQL_MAX_RESULT_BYTES=1048576
SQL_TIMEOUT_SECONDS=10

# File uploads
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=["pdf","docx","xlsx","xls","csv","txt"]

# Initial tenant administrator
INITIAL_TENANT_NAME=Demo Company
INITIAL_TENANT_CODE=demo
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_FULL_NAME=Platform Administrator
INITIAL_ADMIN_PASSWORD=replace_with_a_strong_password

